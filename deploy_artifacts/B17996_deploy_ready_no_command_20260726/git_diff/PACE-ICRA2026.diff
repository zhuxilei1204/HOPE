     return torch.nan_to_num(rate, nan=0.0, posinf=max_rate, neginf=-max_rate)
 
 
+def reward_stage1_upright_progress_height_gated(
+    env: BaseEnv,
+    min_z: float = 0.965,
+    z_transition: float = 0.030,
+    flat_deadband: float = 0.085,
+    pitch_deadband: float = 0.095,
+    flat_std: float = 0.050,
+    pitch_std: float = 0.045,
+    flat_weight: float = 0.55,
+    pitch_weight: float = 0.45,
+    max_rate: float = 1.0,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+) -> torch.Tensor:
+    asset: Articulation = env.scene[asset_cfg.name]
+    if hasattr(env, "robot_pos"):
+        root_z = env.robot_pos[:, 2]
+    else:
+        root_z = asset.data.root_pos_w[:, 2] - env.scene.env_origins[:, 2]
+
+    gravity_xy = asset.data.projected_gravity_b[:, :2]
+    flat_l2 = torch.sum(torch.square(gravity_xy), dim=1)
+    abs_gravity_x = torch.abs(gravity_xy[:, 0])
+    prev_flat_l2 = getattr(env, "stage1_prev_flat_l2", flat_l2).to(device=flat_l2.device, dtype=flat_l2.dtype)
+    prev_gravity_x = torch.abs(getattr(env, "stage1_prev_gravity_x", gravity_xy[:, 0]))
+    prev_gravity_x = prev_gravity_x.to(device=abs_gravity_x.device, dtype=abs_gravity_x.dtype)
+
+    prev_flat_error = torch.clamp(prev_flat_l2 - flat_deadband, min=0.0)
+    current_flat_error = torch.clamp(flat_l2 - flat_deadband, min=0.0)
+    flat_progress = (prev_flat_error - current_flat_error) / (flat_std + 1e-12)
+
+    prev_pitch_error = torch.clamp(prev_gravity_x - pitch_deadband, min=0.0)
+    current_pitch_error = torch.clamp(abs_gravity_x - pitch_deadband, min=0.0)
+    pitch_progress = (prev_pitch_error - current_pitch_error) / (pitch_std + 1e-12)
+
+    progress = flat_weight * flat_progress + pitch_weight * pitch_progress
